{
  "npmCommand": [
    "bun"
  ],
  "warnings": {
    "anthropicExtraUsage": false
  },
  "lastChangelogVersion": "0.84.2",
  "theme": "catppuccin-frappe",
  "defaultThinkingLevel": "high",
  "quietStartup": true,
  "hideThinkingBlock": false,
  "packages": [
    "npm:pi-btw",
    "npm:pi-web-access",
    "npm:@ff-labs/pi-fff",
    "../../repos/pi-spotify-provider"
