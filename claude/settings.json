{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_NON_ESSENTIAL_MODEL_CALLS": "1",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "defaultMode": "bypassPermissions",
    "disableAutoMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/Users/ava.silver/.claude/hooks/rtk-rewrite.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bunx -y ccstatusline@latest",
    "padding": 0,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "gopls-lsp@claude-plugins-official": true,
    "dd@datadog-claude-plugins": true,
    "deveng@datadog-claude-plugins": true,
    "typescript-lsp@claude-plugins-official": true,
    "serverless@datadog-claude-plugins": true,
    "go-code-reviewer@datadog-claude-plugins": true,
    "cq@cq": true,
    "code-review@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true,
    "slack@claude-plugins-official": true,
    "microsoft-docs@claude-plugins-official": true,
    "terraform@claude-plugins-official": true,
    "azure@claude-plugins-official": true,
    "datadog@claude-plugins-official": false
  },
  "extraKnownMarketplaces": {
    "datadog-claude-plugins": {
      "source": {
        "source": "git",
        "url": "https://github.com/DataDog/claude-marketplace.git"
      },
      "autoUpdate": true
    },
    "cq": {
      "source": {
        "source": "github",
        "repo": "mozilla-ai/cq"
      }
    }
  },
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Making a fish",
      "Batting yarn",
      "Chasing the laser pointer",
      "Knocking things off tables",
      "Finding a sunbeam",
      "Squeezing into a box",
      "Ignoring you on purpose",
      "Sharpening claws on furniture",
      "Knocking over a glass",
      "Stealing your chair",
      "Sitting on the keyboard",
      "Staring at the wall",
      "Napping in a sunspot",
      "Hiding in a paper bag",
      "Chasing a moth",
      "Pushing a pen off the desk",
      "Claiming the warm laundry"
    ]
  },
  "effortLevel": "high",
  "awaySummaryEnabled": false,
  "showClearContextOnPlanAccept": true,
  "autoUpdatesChannel": "latest",
  "skipDangerousModePermissionPrompt": true,
  "preferredNotifChannel": "terminal_bell",
  "teammateMode": "auto",
  "voiceEnabled": true
}
