  "extensions": [
    "~/dotfiles/pi/extensions"
  ],
  "skills": [
    "~/skills/skills"
  ],
  "prompts": [
    "~/dotfiles/pi/prompts"
  ],
  "themes": [
    "~/dotfiles/pi/themes"
  ],
  "defaultProvider": "openrouter",
  "defaultModel": "stealth/ox-alpha",
  "enabledModels": [
    "spotify/claude-opus-4-6@default",
    "openrouter/stealth/ox-alpha",
    "spotify/claude-sonnet-4-6@default"
