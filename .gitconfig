[user]
name = Ava Silver
email = ava.silver@datadoghq.com
signingkey = A58F15C1B3F896B9CAB9FD3E8A1F59A9B0DF37A4
[core]
editor = "code --wait"
pager = delta
# fsmonitor/untrackedCache/skipHash are all incompatible with gitstatus's
# libgit2, causing stale dirty status in p10k on large repos.
# feature.manyFiles implies both untrackedCache and skipHash.
# See romkatv/gitstatus#474, romkatv/powerlevel10k#2473, libgit2/libgit2#6531
fsmonitor = false
untrackedCache = false
excludesfile = /Users/ava.silver/.gitignore_global
	hooksPath = /usr/local/dd/global_hooks
[interactive]
diffFilter = delta --color-only
[delta]
dark = true
[merge]
conflictstyle = zdiff3
[alias]
a = add -A
c = "!$HOME/dotfiles/commit.sh"
ac = "!f() { git a && git c $@ ;}; f"
cr = "!$HOME/dotfiles/create.sh"
cc = "!git commit -m \"updated $(date)\""
m = "merge --no-edit"
main = "!git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'"
mm = "!git m $(git main)"
mc = "!git a && git merge --continue"
st = status
sw = switch
sm = "!git sw $(git main)"
pl = "!$HOME/dotfiles/pull.sh"
pu = push origin HEAD
su = "!git branch -u origin/$(git rev-parse --abbrev-ref HEAD)"
rst = reset --hard HEAD
rstm = "!f() { git checkout $(git main) -- $@; }; f"
s = "!f() { git branch --format='%(refname:short)' | fzf --query=\"$1\" --no-sort --height 20% | xargs git switch; }; f"
sta = stash
sp = stash pop
unc = reset --soft HEAD~1
d = diff --color-moved
dn = d --name-only
dm = "!git d $(git main)"
dmn = "!git dn $(git main)"
dh = d HEAD
dhn = dh --name-only
cf = !sh -c \"git diff --name-only | uniq | xargs code\"
lg = log --graph --no-merges --author=Ava --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
l = lg -n
standies = standup
ticket = "!$HOME/dotfiles/ticket.sh"
cln = "clean -fdx"
cleanup-branches = !sh -c \"git b | grep -v $(git main) | xargs git b -D\"
cwt = "!$HOME/dotfiles/clean-worktrees.sh"
restack = "!f() { gt restack || claude --dangerously-skip-permissions 'fix the merge conflicts for the current gt restack, stage the fixes, then run gt continue' ; }; f"
sync = "!f() { branch=$(git b --show-current) && git sm && gt sync -f && gt ss && git sw $branch ; }; f"
trigger-ci = "!f() { git commit --allow-empty -m 'trigger ci'  && git pu ; }; f"
# Fix p10k/gitstatus stale status in repos using feature.manyFiles or fsmonitor.
# See romkatv/gitstatus#474
fix-prompt = "!git config --local feature.manyFiles false && git config --local index.skipHash false && git config --local core.fsmonitor false && git config --local core.untrackedCache false && git update-index --no-fsmonitor && git update-index --no-untracked-cache && echo 'gitstatus-incompatible settings disabled'"
[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true
[init]
defaultBranch = main
[push]
autoSetupRemote = true
[commit]
gpgsign = true
[rerere]
enabled = true
autoupdate = true

[safe]
directory = *
[url "git@github.com:"]
insteadOf = https://github.com/
insteadOf = git://github.com/
[index]
# Explicit override -- feature.manyFiles (often set locally by repo setup
# scripts) implies skipHash=true, which gitstatus/libgit2 cannot parse.
skipHash = false
[maintenance]
repo = /Users/ava.silver/go/src/github.com/DataDog/dd-source
