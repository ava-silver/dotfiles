[user]
name = Ava Silver
email = ava.silver@datadoghq.com
signingkey = A58F15C1B3F896B9CAB9FD3E8A1F59A9B0DF37A4
[core]
editor = "zed --wait"
pager = delta
# gitstatus uses libgit2, which cannot parse the FSMN/UNTR index extensions
# written by fsmonitor/untrackedCache -- causing stale dirty status on non-reftable
# repos. Reftable repos bypass gitstatus entirely (gitcli path) and can enable
# these per-repo via `git setup-reftable-perf`. See romkatv/gitstatus#474.
fsmonitor = false
untrackedCache = false
excludesfile = /Users/ava.silver/.gitignore_global
attributesFile = /Users/ava.silver/.gitattributes
	hooksPath = /usr/local/dd/global_hooks

[interactive]
diffFilter = delta --color-only
[delta]
navigate = true  # use n and N to move between diff sections
dark = true      # or light = true, or omit for auto-detection
# [diff]
# external = difft
[merge]
conflictstyle = zdiff3
[merge "mergiraf"]
name = mergiraf
driver = mergiraf merge --git %O %A %B -s %S -x %X -y %Y -p %P -l %L
[alias]
a = add -A
b = branch
c = "!$HOME/dotfiles/git/scripts/commit.sh"
ac = "!f() { git a && git c $@ ;}; f"
cr = "!$HOME/dotfiles/git/scripts/create.sh"
pr = "!gh pr view --web"
cc = "!git commit -m \"updated $(date)\""
m = "merge --no-edit"
main = "!git symbolic-ref refs/remotes/origin/HEAD | sed 's@^refs/remotes/origin/@@'"
r = "!git rebase $(git main)"
mm = "!git m $(git main)"
mc = "!git a && git merge --continue"
st = status
sw = switch
sm = "!git sw $(git main)"
pl = "!$HOME/dotfiles/git/scripts/pull.sh"
pu = push origin HEAD
su = "!git branch -u origin/$(git rev-parse --abbrev-ref HEAD)"
co = checkout
rst = reset --hard HEAD
rstm = "!f() { git checkout $(git main) -- $@; }; f"
s = "!f() { git branch --format='%(refname:short)' | fzf --query=\"$1\" --no-sort --height 20% | xargs git switch; }; f"
sta = stash
sp = stash pop
unc = reset --soft HEAD~1
d = diff --color-moved
dt = -c diff.external=difft diff --color-moved
dn = d --name-only
dm = "!git d $(git main)"
dmn = "!git dn $(git main)"
dh = d HEAD
dhn = dh --name-only
cf = !sh -c \"git diff --name-only | uniq | xargs zed\"
lg = log --graph --no-merges --author=Ava --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
cleanup-lock = "!f() { lock=$(git rev-parse --git-path index.lock) || return; if [ -e \"$lock\" ]; then rm -v \"$lock\"; else echo \"No index lock: $lock\"; fi; }; f"
l = cleanup-lock
standies = standup
ticket = "!$HOME/dotfiles/git/scripts/ticket.sh"
cln = "clean -fdx"
cleanup-branches = !sh -c \"git b | grep -v $(git main) | xargs git b -D\"
cwt = "!$HOME/dotfiles/git/scripts/clean-worktrees.sh"
dwt = "!$HOME/dotfiles/git/scripts/delete-worktree.sh"
copy-stack = "!$HOME/dotfiles/git/scripts/copy-stack.sh"
cs = copy-stack
restack = "!f() { gt restack || pi 'fix the merge conflicts for the current gt restack, stage the fixes, then run gt continue' ; }; f"
sync = "!gt s && gt ss"
trigger-ci = "!f() { git commit --allow-empty -m 'trigger ci'  && git pu ; }; f"
# Enable fsmonitor + untrackedCache for reftable repos -- safe because they use the
# gitcli prompt path, not gitstatus/libgit2. Dramatically speeds up `git status`.
setup-reftable-perf = "!git config --local core.fsmonitor true && git config --local core.untrackedCache true && echo 'fsmonitor + untrackedCache enabled'"
wt = !$HOME/dotfiles/git/scripts/worktree.sh
[filter "lfs"]
clean = git-lfs clean -- %f
smudge = git-lfs smudge -- %f
process = git-lfs filter-process
required = true
[init]
defaultBranch = main
[push]
autoSetupRemote = true
[commit]
gpgsign = true
[rerere]
enabled = true
autoupdate = true

[safe]
directory = *
[url "git@github.com:"]
insteadOf = https://github.com/
insteadOf = git://github.com/
[index]
# feature.manyFiles (set locally by some repo setup scripts) implies skipHash=true,
# which gitstatus/libgit2 cannot parse. Explicit global override.
skipHash = false
[maintenance]
repo = /Users/ava.silver/go/src/github.com/DataDog/dd-source
[include]
	path = /Users/ava.silver/.config/datadog/git/config
